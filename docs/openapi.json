{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "The API of Xovê, a private room where invited friends share their screens and cameras. Every path is under /api, on the web app's own origin. A signed-in call carries the session cookie; every POST, PUT and DELETE also sends the XSRF-TOKEN cookie's value in the X-XSRF-TOKEN header. Errors are RFC 9457 problem details. Signing in (Google) and logging out aren't listed: see docs/api.md.",
    "title" : "Xovê API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/access-requests" : {
      "post" : {
        "description" : "Signed in, not a member yet.",
        "operationId" : "requestAccess",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NewAccessRequest"
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A message over 500 characters"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not signed in"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Without the CSRF token, or not allowed"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Already a member, or a request is already waiting"
          }
        },
        "security" : [ {
          "session" : [ ]
        } ],
        "summary" : "Ask for access, with an optional message",
        "tags" : [ "access-request-controller" ]
      }
    },
